// Docket's settings, read from this file (see `--help` for pointing
// DOCKET_CONFIG elsewhere). This copy is the local-dev one; `just dev`
// builds with the `dev` feature, which seeds the database with fixtures the
// first time and stands in for Tailscale. Delete docket.db to start over.
bind "127.0.0.1:3000"
database "docket.db"
// log "warn"

// A Fastmail API token per login (ADR 1). The name is the account's slug;
// the token lives in the named file, never in this config. Local dev runs
// with none and stands in with fixtures.
// credential "household" token-file="/run/credentials/docket/household"
// credential "eli" token-file="/run/credentials/docket/eli"
